# LOCAL DEVELOPMENT ONLY. Do not put real device keys in this file.
SUBAKO_APP_ENV=development
SUBAKO_DATA_MODE=simulation
SUBAKO_DATABASE_URL=sqlite:///./subako-dev.db
SUBAKO_COOKIE_SECURE=false
SUBAKO_ALLOWED_ORIGINS=["http://127.0.0.1:5173","http://localhost:5173"]
SUBAKO_SIMULATOR_ENABLED=true
SUBAKO_SIMULATOR_INTERVAL_SECONDS=10
SUBAKO_STALE_SECONDS=30
SUBAKO_OFFLINE_SECONDS=90
# Demo seed requires an explicit 14+ character password in the process environment.
# tools/dev.py creates a random local password without storing it in source.
